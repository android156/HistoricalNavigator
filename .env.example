# Copy this file to .env for local development.
# Flask starts without these keys, but map/search and AI generation need them.

FLASK_SECRET_KEY=change-me-local-dev
DATABASE_URL=sqlite:///history.db
PORT=5000

# Browser-side Yandex Maps key. Without it, the page renders but the map cannot load.
YANDEX_MAPS_API_KEY=

# Server-side OpenAI key. Without it, /api/historical-data returns HTTP 503.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium

# Optional HTTP/HTTPS proxy used only for OpenAI requests.
# Example: http://user:password@proxy.example:8080
PROXY_URL=
